# SnapHere 环境变量示例
# 复制为 .env.local（本地开发）或配置到部署平台（生产环境）后填入真实值。
# 请勿把包含真实密钥的文件提交到仓库。

# ===== 数据库（必需）=====
DATABASE_URL="postgresql://user:password@localhost:5432/iamhere?schema=public"

# ===== NextAuth（必需）=====
NEXTAUTH_URL="http://localhost:3000"
# 生成方式: openssl rand -base64 32
NEXTAUTH_SECRET=""

# ===== Google OAuth（必需）=====
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ===== Twitter OAuth（必需）=====
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""

# ===== Google AI（必需）=====
GOOGLE_AI_API_KEY=""

# ===== Mapbox（必需）=====
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=""

# ===== 邮件服务（可选，未配置时无法使用邮箱魔法链接登录）=====
RESEND_API_KEY=""
EMAIL_FROM="noreply@snaphere.app"

# ===== 图片存储（可选，默认本地存储）=====
STORAGE_PROVIDER="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""
AWS_S3_BUCKET=""

# ===== 本地开发（可选）=====
# 开发环境访问 Google/Twitter/Gemini 使用的代理地址
DEV_PROXY_URL="http://127.0.0.1:1087"
# 需要更换开发端口时设为 true，跳过中间件的主机名重定向
DISABLE_DEV_HOST_ENFORCE="false"
